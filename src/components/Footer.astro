---
const currentYear = new Date().getFullYear();
---

<footer>
    <p><span data-footer-year>{currentYear}</span> Simone X Sun</p>
</footer>

<script>
    const year = document.querySelector('[data-footer-year]');
    if (year) year.textContent = String(new Date().getFullYear());
</script>

<style>
    footer {
        align-self: stretch;
        padding: 32px 0;
        overflow: hidden;
        justify-content: center;
        background-color: #f8f9fa;
    }

    p {
        font-size: 16px;
        word-wrap: break-word;
        justify-content: flex-start;
        text-align: center;
        align-items: center;
        font-family: "League Spartan Variable", sans-serif;
    }
</style>
